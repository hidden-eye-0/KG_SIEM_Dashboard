# ---------------------------------------------------------------------------
# Adaptive Knowledge Graph SIEM Investigation Framework — environment template
# Copy to .env and fill in. NEVER commit .env. Nothing here is sent to React.
# Everything is optional: with an empty file the system runs fully offline
# (in-process document store, in-memory graph, heuristic policy, no TI).
# ---------------------------------------------------------------------------

# ---- LLM (Gemini) ----------------------------------------------------------
# The model is never hard-coded; availability is verified with models.list()
# at startup and the app falls back to the heuristic policy + template
# narrative if the key/model is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Threat intelligence (optional, passive reputation lookups only) -------
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
TI_CACHE_TTL_SECONDS=21600

# ---- Databases (decision D7: MongoDB Atlas + Neo4j Aura Free) --------------
# Leave empty to use mongomock (in-process, non-persistent) and NetworkX.
MONGODB_URI=
MONGODB_DB=siem_kg
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Investigation safeguards (Adaptive Evidence Agent hard limits) --------
MAX_INVESTIGATION_STEPS=12
MAX_EVENTS_PER_QUERY=500
MAX_TIME_WINDOW_SECONDS=86400
MAX_GRAPH_NODES=300
MAX_LLM_CALLS_PER_INVESTIGATION=20
MAX_TI_LOOKUPS_PER_INVESTIGATION=10
INVESTIGATION_TIMEOUT_SECONDS=300
INVESTIGATION_POLICY=llm          # llm | heuristic  (llm silently degrades to heuristic without a key)
SUFFICIENCY_THRESHOLD=0.8

# ---- Data / ML -------------------------------------------------------------
# DATASET PLACEHOLDER: put the CICIoT2023 part-*.csv files here (or point this
# at the folder that contains them) and re-run `python -m ml.pipeline run`.
# While the folder is empty the pipeline generates clearly-labelled synthetic
# demo flows (data_source=synthetic_demo) so the whole UI can be exercised.
DATASET_DIR=./data/raw
PROCESSED_DIR=./data/processed
ARTIFACTS_DIR=./ml/artifacts
REPORTS_DIR=./data/reports
SCENARIOS_DIR=./data/scenarios
INSPECT_CHUNKSIZE=100000
SUBSET_MAX_PER_CLASS=100000       # majority classes capped (stratified reservoir, seed below); minority classes kept in full
RANDOM_SEED=42
DEMO_FLOWS_PER_CLASS=600          # only used in demo (placeholder) mode
AUTO_SEED_DEMO=true               # run the pipeline automatically at API start-up when the store is empty

# ---- App -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
AUTH_REQUIRED=false               # true = JWT login required for the API/UI
# When AUTH_REQUIRED=true, JWT_SECRET and DEMO_ANALYST_PASSWORD must be changed from defaults.
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
DEMO_ANALYST_USERNAME=analyst
DEMO_ANALYST_PASSWORD=change-me

# ---- Live ingestion --------------------------------------------------------
# The final detector can POST post-inference events to /api/ingest. The detector
# itself remains external until the final model integration step.
# Batch limit is enforced server-side at 500 events.
LOG_LEVEL=INFO
